# Copy to canary.env and replace placeholders with real values.
ARK_OPERATOR=ODIN
JANUS_HOST=janus
JANUS_USER=u0_a000
EDEN_HOST=100.83.241.3
EDEN_USER=ray
SSH_OPTS='-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new'

# Each command MUST return non-zero on failure and print a machine-readable receipt token on success.
JANUS_AUTH_COMMAND='ark-janus authorize --stdin'
HYPERNET_ROUTE_COMMAND='ark-hypernet route --stdin'
EDEN_EXEC_COMMAND='ark-eden canary-exec --stdin'
PACKET_OS_COMMAND='ark-packet ingest --stdin'
WORKFORCE_COMMAND='ark-workforce execute --stdin'
SECA_COMMAND='ark-seca verify --stdin'
DEVOS_COMMAND='ark-devos verify --stdin'
PROOFGRID_COMMAND='ark-proof seal --stdin'
THOTH_COMMAND='ark-thoth commit --stdin'
