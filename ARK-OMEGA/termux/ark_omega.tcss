Screen { background: #05070a; color: #d9e2ea; }
Header { background: #0a0e13; color: #ffffff; }
Footer { background: #0a0e13; color: #8ea1b5; }
#statusbar { height: 3; background: #0b1118; border-bottom: solid #32465b; padding: 0 2; }
#brand { width: 1fr; text-style: bold; color: #ffffff; content-align: left middle; }
#peer,#trust,#proto { width: auto; margin-left: 3; color: #9ec7e8; content-align: right middle; }
#workspace { height: 1fr; }
#nav { width: 24; background: #080c11; border-right: solid #26384a; padding: 1; }
#content { width: 1fr; padding: 2 3; background: #06090d; }
.section-title,#screen-title { color: #9ec7e8; text-style: bold; margin-bottom: 1; }
.nav-item { height: 2; color: #aab8c5; }
#screen-body { border: solid #26384a; padding: 2 3; background: #080c11; height: 1fr; }
#commandbar { height: 3; border-top: solid #26384a; background: #090d12; padding: 0 2; }
#hotkeys { content-align: center middle; color: #8ea1b5; }
#modal { width: 54; height: auto; max-height: 22; border: double #6f95b8; background: #0a0f15; padding: 1 2; align: center middle; }
#modal-title { text-style: bold; color: #ffffff; margin-bottom: 1; }
#modal-list { height: auto; max-height: 14; }
#modal-help { color: #7f93a8; margin-top: 1; }
